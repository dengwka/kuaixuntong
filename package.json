{
  "name": "kuaixuntong",
  "version": "1.1.1",
  "description": "快讯通 - 实时突发财经与宏观事件监控助手",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "kuaixuntong",
    "jin10",
    "financial",
    "news",
    "alert",
    "desktop",
    "tray"
  ],
  "homepage": "https://github.com/dengwka/kuaixuntong",
  "author": {
    "name": "dengwk",
    "email": "wenkan_g@163.com"
  },
  "license": "MIT",
  "build": {
    "appId": "cn.antigravity.kuaixuntong",
    "productName": "快讯通",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dengwka",
        "repo": "kuaixuntong"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app_icon.ico",
      "artifactName": "kuaixuntong-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "快讯通",
      "artifactName": "kuaixuntong-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/app_icon.icns",
      "category": "public.app-category.finance",
      "artifactName": "kuaixuntong-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "kuaixuntong-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "dengwk <wenkan_g@163.com>",
      "icon": "assets/app_icon.png",
      "category": "Finance",
      "artifactName": "kuaixuntong-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "dengwk <wenkan_g@163.com>"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}